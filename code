eth = pd.read_csv('uc_admissions_summary_by_ethnicity.csv')

d = eth[(eth.fall_term == 2025) & (eth.entrant_level == 'freshman') & (eth.campus != 'Systemwide')]
d = d[d.ethnicity.isin(['White', 'Hispanic/Latino(a)'])]

pivot_app = d[d.count_type == 'App'].pivot(index='campus', columns='ethnicity', values='n')
pivot_adm = d[d.count_type == 'Adm'].pivot(index='campus', columns='ethnicity', values='n')

rate = pivot_adm / pivot_app
rate.columns = ['hisp_rate', 'white_rate']
rate['white_higher'] = rate['white_rate'] > rate['hisp_rate']
print(rate.round(4))
print(rate['white_higher'].sum())  # 9

