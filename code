from sklearn.linear_model import LinearRegression

dash = pd.read_csv('bay_area_modeling_table.csv')  # raw table, so we build our own model
berk = dash[(dash.campus == 'Berkeley') & (dash.fall_term.between(2022, 2025))].copy()

cols = ['admit_rate', 'ag_completion_rate', 'frpm_pct', 'applicant_gpa', 'graduates']
model_df = berk[['high_school', 'fall_term'] + cols].dropna(subset=cols).reset_index(drop=True)

X = model_df[['ag_completion_rate', 'frpm_pct', 'applicant_gpa', 'graduates']]  # graduates = school-size proxy
y = model_df['admit_rate']

reg = LinearRegression().fit(X, y)
model_df['expected_admit_rate'] = reg.predict(X)
model_df['residual'] = model_df['admit_rate'] - model_df['expected_admit_rate']

targets = ['HERCULES HIGH SCHOOL', 'MISSION SENIOR HIGH SCHOOL', 'PHILLIP & SALA BURTON ACAD HS']
result = model_df[model_df.high_school.isin(targets)]
print(result.groupby('high_school')[['admit_rate', 'expected_admit_rate', 'residual']]
      .mean().sort_values('residual', ascending=False))
