import pandas as pd
eth = pd.read_csv('uc_admissions_summary_by_ethnicity.csv')

sub = eth[(eth.fall_term == 2025) & (eth.count_type == 'App')]

campus_apps = sub[sub.campus != 'Systemwide']['n'].sum()      # sum of per-campus application counts
unique_applicants = sub[sub.campus == 'Systemwide']['n'].sum()  # deduplicated applicant count

avg_campuses_per_applicant = campus_apps / unique_applicants
print(round(avg_campuses_per_applicant, 2))  # 4.4

dash = pd.read_csv('dashboard_data.csv')

ucla_2025 = dash[
    (dash.fall_term == 2025) &
    (dash.campus == 'Los Angeles') &
    (dash.school_type == 'High Schools (Public)')
]

total_applicants = ucla_2025['applicants'].sum()
total_admits = ucla_2025['admits'].sum()
admit_rate = total_admits / total_applicants
print(round(admit_rate, 4))  # 0.0829

disc = pd.read_csv('uc_freshman_admission_by_discipline.csv')

d = disc[disc.fall_term == 2025]
overall = d[d.broad_discipline == 'All disciplines'].set_index('campus')['admit_rate']
cs = d[d.broad_discipline == 'Computer Science'].set_index('campus')['admit_rate']

compare = pd.DataFrame({'overall_admit_rate': overall, 'cs_admit_rate': cs})
compare['gap'] = compare['overall_admit_rate'] - compare['cs_admit_rate']
print(compare.sort_values('gap', ascending=False))

